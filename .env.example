# Copy to .env and adjust. .env is gitignored and must never be committed.

APP_ENV=development
APP_PORT=8000

# Matches docker-compose.yml
DATABASE_URL=postgresql://prism:prism@localhost:5432/prism
REDIS_URL=redis://localhost:6379/0

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Catalog build
ABO_S3_BUCKET=amazon-berkeley-objects
CATALOG_CONTEXT_SIZE=750
CATALOG_CORE_SIZE=60

# Telemetry
POINTER_SAMPLE_HZ=50
FLUSH_INTERVAL_MS=250
SESSION_IDLE_TIMEOUT_MIN=30
RETENTION_DAYS=90
