# ---- Never commit these. The first two are the ones that matter. ----

# Source imagery and derived thumbnails. Hundreds of megabytes.
# Commit the pipeline, not its output.
data/raw/
data/images/
data/thumbs/
catalog/downloads/
# Generated catalog build artifact (data + brand/price/rating text), fully
# reproducible via `python -m catalog.build`. Same "commit the pipeline,
# not its output" reasoning as the two rules above. Added during the
# catalog pipeline build — not part of the original file.
data/catalog.json
data/spotcheck_*.png

# Structural reference screenshots of a third-party retailer.
# Local reference only. These must never enter a commit or a deploy.
docs/reference/

